#pragma code_page(65001)
#include <windows.h>
#include <winres.h>
#include "resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 330, 555
STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "ZMouseShow 设置"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "修改后可立即应用；高级参数仍可在 TOML 中调整。", -1, 12, 10, 306, 12

    GROUPBOX        "触发方式（可同时启用）", -1, 8, 28, 314, 132
    CONTROL         "启用鼠标晃动触发(&S)", IDC_SHAKE_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 42, 138, 14
    LTEXT           "灵敏度：", -1, 164, 44, 38, 12
    CONTROL         "", IDC_SHAKE_SENSITIVITY, "msctls_trackbar32", TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP, 202, 39, 70, 19
    LTEXT           "", IDC_SHAKE_SENSITIVITY_VALUE, 274, 44, 42, 12
    CONTROL         "启用双击 Ctrl(&C)", IDC_DOUBLE_CTRL_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 62, 140, 14
    LTEXT           "Ctrl 侧(&L)：", -1, 36, 84, 64, 12
    COMBOBOX        IDC_CTRL_SIDE, 103, 81, 88, 70, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "启用自定义组合键(&H)", IDC_HOTKEY_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 106, 140, 14
    CONTROL         "", IDC_HOTKEY_CAPTURE, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 36, 124, 108, 14
    CONTROL         "包含 Win(&W)", IDC_HOTKEY_WINDOWS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 152, 124, 76, 14
    PUSHBUTTON      "恢复默认", IDC_HOTKEY_RESET, 250, 123, 58, 14, WS_TABSTOP
    LTEXT           "", IDC_HOTKEY_SUMMARY, 36, 142, 272, 11

    GROUPBOX        "定位效果", -1, 8, 166, 314, 138
    CONTROL         "启用自动超时(&T)", IDC_AUTO_TIMEOUT_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 180, 130, 14
    LTEXT           "高亮形状(&P)：", -1, 18, 202, 72, 12
    COMBOBOX        IDC_SPOTLIGHT_SHAPE, 92, 199, 96, 62, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "高亮半径(&R)：", -1, 18, 222, 72, 12
    EDITTEXT        IDC_RADIUS_DIP, 92, 219, 48, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "DIP（32–512）", -1, 146, 222, 76, 12
    LTEXT           "暗化强度(&D)：", -1, 18, 242, 72, 12
    EDITTEXT        IDC_DIM_OPACITY, 92, 239, 48, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "%（10–90）", -1, 146, 242, 76, 12
    CONTROL         "高亮描边(&F)", IDC_FOCUS_RING_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 264, 100, 14
    CONTROL         "启动波纹(&V)", IDC_RIPPLE_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 140, 264, 100, 14
    CONTROL         "十字定位线(&X)", IDC_CROSSHAIR_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 284, 100, 14
    CONTROL         "放大光标(&U)", IDC_ENLARGED_CURSOR_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 140, 284, 86, 14
    EDITTEXT        IDC_CURSOR_SCALE_PERCENT, 230, 282, 36, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "%（125–400）", -1, 270, 284, 48, 12

    GROUPBOX        "局部放大镜（可独立于暗化遮罩）", -1, 8, 308, 314, 132
    LTEXT           "定位模式：", -1, 18, 324, 58, 12
    COMBOBOX        IDC_LOCATOR_MODE, 78, 321, 130, 66, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "启用暗化遮罩", IDC_DIM_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 346, 110, 14
    CONTROL         "启用局部放大镜", IDC_MAGNIFIER_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 140, 346, 120, 14
    LTEXT           "倍率：", -1, 18, 370, 42, 12
    EDITTEXT        IDC_MAGNIFIER_ZOOM, 62, 367, 42, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "%（125–400）", -1, 108, 370, 82, 12
    LTEXT           "尺寸：", -1, 18, 392, 42, 12
    EDITTEXT        IDC_MAGNIFIER_DIAMETER, 62, 389, 42, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "DIP（160–640）", -1, 108, 392, 86, 12
    LTEXT           "形状：", -1, 18, 415, 42, 12
    COMBOBOX        IDC_MAGNIFIER_SHAPE, 62, 412, 102, 58, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "边缘：", -1, 178, 415, 42, 12
    COMBOBOX        IDC_MAGNIFIER_EDGE_EFFECT, 220, 412, 88, 58, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "行为与启动", -1, 8, 446, 314, 70
    LTEXT           "全屏抑制(&M)：", -1, 18, 461, 72, 12
    COMBOBOX        IDC_FULLSCREEN_SUPPRESSION, 92, 458, 102, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "登录后自启动(&B)", IDC_STARTUP_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 204, 460, 104, 14
    LTEXT           "排除程序(&E)：", -1, 18, 484, 72, 12
    EDITTEXT        IDC_EXCLUDED_PROCESSES, 92, 481, 216, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "仅填写 EXE 文件名，多个名称用分号分隔。", -1, 92, 498, 216, 10

    LTEXT           "“应用”会立即更新当前效果并保存到便携 TOML。", -1, 12, 520, 206, 12
    PUSHBUTTON      "恢复默认配置(&Z)", IDC_RESTORE_DEFAULTS, 12, 537, 92, 14, WS_TABSTOP
    DEFPUSHBUTTON   "确定", IDOK, 162, 537, 48, 14, WS_TABSTOP
    PUSHBUTTON      "取消", IDCANCEL, 214, 537, 48, 14, WS_TABSTOP
    PUSHBUTTON      "应用(&A)", IDC_APPLY_SETTINGS, 266, 537, 52, 14, WS_DISABLED | WS_TABSTOP
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "ZMouseShow contributors\0"
            VALUE "FileDescription", "Portable mouse locator\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "InternalName", "ZMouseShow\0"
            VALUE "OriginalFilename", "ZMouseShow.exe\0"
            VALUE "ProductName", "ZMouseShow\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
